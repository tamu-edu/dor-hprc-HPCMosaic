sub get_latest_sw_version {
    # may not work for all version naming conventions
    my $sw_name = shift;
    my $sw_version = shift;
    my $tmp_version = $sw_version;
    $tmp_version =~ s/^(\d+)\.(\d+)\./$1$2/;    # used to compare versions in format: 11.11.11

    if (exists $sw_latest_version{$sw_name}) {
        my $tmp_latest_version = $sw_latest_version{$sw_name};
        $tmp_latest_version =~ s/^(\d+)\.(\d+)\./$1$2/;
        $sw_latest_version{$sw_name} = $sw_version if $tmp_version > $tmp_latest_version;
    }
    else {
        $sw_latest_version{$sw_name} = $sw_version
    }
    # 2022-1 2020-1
