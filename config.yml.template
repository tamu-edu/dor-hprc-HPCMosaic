development: &common_settings
  cluster_name: "${CLUSTERNAME}"
  announcements_file: "var/announcements/announcements.json"
  dashboard_url: "/pun/dev/${APPNAME}"
  file_app_url: "/pun/sys/files/fs"
  file_editor_url: "/pun/sys/file-editor/edit"
  home_page: "https://hprc.tamu.edu"
  request_email: "help@hprc.tamu.edu"
  help_email: "help@hprc.tamu.edu"
  modules_db_path: "/sw/hprc/sw/portal_utils/modules.sqlite3"
  driver_scripts_path: "/var/www/ood/apps/dev/${USERNAME}/${APPNAME}/machine_driver_scripts"
  hprcbot_route: 'http://courant.hprc.tamu.edu:8553'
  default_python_venv: "/sw/hprc/sw/Python/virtualenvs/Python/3.8.6/default_dashboard_python-env/"
  dashboard_fonts:
    default: "inter"
    options:
      - key: "inter"
        label: "Inter"
        family: "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
      - key: "open-sans"
        label: "Open Sans"
        family: "\"Open Sans\", Arial, sans-serif"
      - key: "system"
        label: "System"
        family: "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
      - key: "serif"
        label: "Serif"
        family: "Georgia, \"Times New Roman\", serif"

production:
  <<: *common_settings
  dashboard_url: "/pun/sys/${APPNAME}"
  announcements_file: "/var/www/ood/apps/sys/${APPNAME}/var/announcements/announcements.json"
  request_email: "help@hprc.tamu.edu"
  driver_scripts_path: "/var/www/ood/apps/sys/${APPNAME}/machine_driver_scripts"
  help_email: "help@hprc.tamu.edu"
