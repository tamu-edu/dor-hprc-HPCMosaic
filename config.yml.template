development: &common_settings
  cluster_name: "${CLUSTERNAME}"
  # Set LOGIN_NODE during setup. ACES defaults to alogin3.cluster; Grace and
  # FASTER deployments should provide their own internal login-node hostname.
  login_node: "${LOGIN_NODE}"
  announcements_file: "var/announcements/announcements.json"
  dashboard_url: "/pun/dev/${APPNAME}"
  file_app_url: "/pun/sys/files/fs"
  file_editor_url: "/pun/sys/file-editor/edit"
  home_page: "https://hprc.tamu.edu"
  request_email: "help@hprc.tamu.edu"
  help_email: "help@hprc.tamu.edu"
  hprcbot_route: 'http://courant.hprc.tamu.edu:8553'
  # Mail relay for the quota-request email fallback (defaults shown).
  # smtp_host: smtp.tamu.edu
  # smtp_port: 25
  # Site tools the backend runs. Uncomment and set any path that differs at
  # your site; unset tools default to the TAMU paths shown. Expected output
  # formats are in docs/sysadmin/widgets.md.
  # tools:
  #   showquota: /sw/local/bin/showquota
  #   myproject: /sw/local/bin/myproject
  #   pestat: /sw/local/bin/pestat
  #   retrieve_sinfo: /sw/local/bin/retrieve_sinfo
  #   cpuavail: /sw/local/bin/cpuavail
  #   toolchains: /sw/local/bin/toolchains
  #   delete_venv: /sw/local/bin/delete_venv
  #   create_venv: /sw/local/bin/create_venv   # path on login_node
  #   modulair: modulair                       # on login_node's PATH
  dashboard_fonts:
    default: "inter"
    options:
      - key: "inter"
        label: "Inter"
        family: "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
      - key: "open-sans"
        label: "Open Sans"
        family: "\"Open Sans\", Arial, sans-serif"
      - key: "system"
        label: "System"
        family: "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
      - key: "serif"
        label: "Serif"
        family: "Georgia, \"Times New Roman\", serif"

production:
  <<: *common_settings
  dashboard_url: "/pun/sys/${APPNAME}"
  announcements_file: "/var/www/ood/apps/sys/${APPNAME}/var/announcements/announcements.json"
  request_email: "help@hprc.tamu.edu"
  help_email: "help@hprc.tamu.edu"
