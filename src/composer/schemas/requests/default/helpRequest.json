{
      
   "helpRequest": {
      "type": "select",
      "label": "What do you need help with?*",
      "name": "helpRequest",
      "required":true,
      "options": [
         { "value": "software", "label": "Software Installation" },
         { "value": "accounts", "label": "Accounts" },
         { "value": "jobs", "label": "Job" },
         { "value": "other", "label": "Other" }
      ]
   },

   "softwareQestions": {
      "type": "collapsibleColContainer",
      "title": "Software Installation Requests",
      "condition" : "helpRequest.software",
      "elements": {

         "softwareNote": {
            "type": "staticText",
            "value": "Software requests are evaluated by HPRC staff.",
            "isHeading": false
         },
   
 
         "softwareCategory": {
            "type": "radioGroup",
            "label": "Software category (used to route the request to the appropriate channel)",
            "name": "softwareCategory",
            "required":true,
            "options": [
               { "value": "bio", "label": "Bio" },
               { "value": "engineering", "label": "Engineering" },
               { "value": "general", "label": "Other" }
            ]
         },


         "SoftwareInfoContainer": {
            "type": "rowContainer",
            "elements": {
        
               "softwareName": {
                  "type": "text",
                  "label": "Name of software",
                  "name": "softwareName",
		  "required":true,
                  "help": "Name of software"
               },

               "softwareVersion": {
                  "type": "text",
                  "label": "Software version",
                  "name": "softwareVersion",
                  "help": "Software version"
               }
            }
         },

         "softwareLink": {
            "type": "text",
            "label": "Software download page",
            "name": "softwareLink",
            "help": "Software download page"
         }, 

         "softwareToolchain": {
            "type": "text",
            "label": "Preferred toolchain",
            "name": "softwareToolChain",
            "help": "Preferred toolchain"
         },    


         "softwareOptional": {
            "type": "textarea",
            "label": "Additional information",
            "name": "softwareInfo",
            "help": "Enter any relevant information that might help with installing the software. If this is licensed software, provide the license information."
         }   
      }  
   },

   "jobQestions": {
      "type": "collapsibleColContainer",
      "title": "Job Help",
      "condition" : "helpRequest.jobs",
      "elements": {

         "jobRequestType": {
            "type": "select",
            "label": "What kind of job help do you need?*",
            "name": "jobRequestType",
            "required": true,
            "options": [
               { "value": "question", "label": "Job-Related Questions" },
               { "value": "walltimeExtension", "label": "Walltime Extension" }
            ]
         },

         "jobID": {
            "type": "text",
            "label": "Provide the job ID",
            "name": "jobID",
	    "required":true,
            "help": "Provide the job ID",
            "condition": "jobRequestType.question"
         },

          "jobLocation": {
            "type": "text",
            "label": "Provide the location of the job script",
            "name": "jobLocation",
            "help": "Provide the location of the job script",
            "condition": "jobRequestType.question"
         },


         "jobIssue": {
            "type": "textarea",
            "label": "Provide detailed information about your job issue",
            "name": "jobIssue",
	    "required":true,
            "help": "Describe the job issue in detail",
            "condition": "jobRequestType.question"
         },

         "jobIrrors": {
            "type": "textarea",
            "label": "Copy and paste any relevant output",
            "name": "jobErrors",
            "help": "Provide any output or error messages relevant to the issue",
            "condition": "jobRequestType.question"
         },

         "walltimeNote": {
            "type": "staticText",
            "value": "Walltime extensions are a courtesy and are not guaranteed. Availability depends on cluster utilization and current resource constraints. HPRC staff will review your request and respond accordingly.",
            "isHeading": false,
            "condition": "jobRequestType.walltimeExtension"
         },

         "walltimeJobID": {
            "type": "runningJobSelect",
            "label": "Select a running job*",
            "name": "walltimeJobID",
            "required": true,
            "condition": "jobRequestType.walltimeExtension",
            "help": "Only your currently running jobs are listed."
         },

         "walltimeExtension": {
            "type": "text",
            "label": "Additional walltime (HH:MM or HH:MM:SS)*",
            "name": "walltimeExtension",
            "required": true,
            "condition": "jobRequestType.walltimeExtension",
            "help": "Enter the amount of additional time requested."
         },

         "walltimeReason": {
            "type": "textarea",
            "label": "Why is this extension needed?*",
            "name": "walltimeReason",
            "required": true,
            "condition": "jobRequestType.walltimeExtension",
            "help": "Provide enough detail for HPRC staff to review the request."
         }
      }
   },

   "accountQestions": {
      "type": "collapsibleColContainer",
      "title": "Account-Related Questions",
      "condition" : "helpRequest.accounts",
      "elements": {

         "accountScopeNote": {
            "type": "staticText",
            "value": "Accounts are for allocations, SUs, and related issues. For access to a shared directory, use Group Management instead.",
            "isHeading": false
         },

         "accountType": {
            "type": "select",
            "label": "What do you need help with?*",
            "name": "accountType",
            "required":true,
            "options": [
               { "value": "general", "label": "General account question" },
               { "value": "addAccount", "label": "Add user to account" },
               { "value": "transferSU", "label": "Transfer SUs" }
            ]
         },
      
         "accountGeneral": {
            "type": "textarea",
            "label": "Describe your account question in as much detail as possible",
            "name": "jobIssue",
            "help": "Describe your account question in as much detail as possible",
            "condition" : "accountType.general"
         },

         "accountAddNote": {
            "type": "staticText",
            "value": "Provide the account number and the name of the user you want to add to the project account.",
            "isHeading": false,
            "condition" : "accountType.addAccount"
         },

         "accountAddNote": {
            "type": "staticText",
            "value": "Provide the account number, the name of the user receiving the SUs, and the number of SUs to transfer.",
            "isHeading": false,
	    "required": true,
            "condition" : "accountType.transferSU"
         },

         "AccounteInfoContainer": {
            "type": "rowContainer",
            "elements": {

               "accountNumber": {
                  "type": "text",
                  "label": "Account number",
                  "name": "accountNumber",
                  "help": "Provide the account number",
		  "required":true,
                  "condition" : "accountType.addAccount || accountType.transferSU"
               },

               "accountUser": {
                  "type": "text",
                  "label": "User",
                  "name": "accountUser",
                  "help": "User",
		  "required": true,
                  "condition" : "accountType.addAccount || accountType.transferSU"
               },

               "accountSU": {
                  "type": "text",
                  "label": "Number of SUs to transfer",
                  "name": "jobIssue",
		  "required": true,
                  "help": "Number of SUs to transfer",
                  "condition" : "accountType.transferSU"
               }
            }
         }
      }
   },

   "OtherQestions": {
      "type": "collapsibleColContainer",
      "title": "Other Questions",
      "condition" : "helpRequest.other",
      "elements": {

         "otherDesciption": {
            "type": "textarea",
            "label": "Describe your issue. Provide as much detail as possible",
            "name": "otherDescription",
	    "required":true,
            "help": "Describe your issue. Provide as much detail as possible"
         }
      }
   }



}
